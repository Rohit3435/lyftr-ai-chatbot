# Add two valid keys for the same provider/model combination before sending chat requests.
LLM_API_KEYS=your_provider_key_1,your_provider_key_2
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are Lyftr AI, a helpful and concise assistant.

# Frontend build-time API URL. Keep this public URL free of provider credentials.
VITE_API_URL=http://localhost:8000
